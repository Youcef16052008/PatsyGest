# === PâtisGest — copier vers .env.local et remplir ===
# Supabase > Project Settings > API
# (valeurs PUBLIques, embarquées dans le bundle navigateur — aucune clé service-role
#  ni chaîne de connexion n'est nécessaire pour l'application)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle-ta-cle-anon-publique-ici

# === Démo locale (développement uniquement, jamais en production) ===
# Les boutons « Essayer » créent un cookie signé côté serveur, sans session Supabase.
# Les données vivent uniquement dans le localStorage du navigateur.
PATISGEST_DEMO_MODE=true
PATISGEST_DEMO_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum

# === Outils Drizzle uniquement (npm run db:studio / db:push) — optionnel ===
# Non requis par l'application ni par Vercel.
# DATABASE_URL=postgresql://postgres:...@aws-0-eu-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true

# Anti-abus vitrine par source (revue B-008). Secret d'au moins 32 caractères,
# jamais commité. Hors production, absent ou trop court : seul le plafond global
# de la base s'applique. En production, absent ou trop court : les commandes
# publiques sont refusées (échec fermé) plutôt que non plafonnées par source.
VITRINE_SECRET_ANTI_ABUS=

# Domaine racine des vitrines publiques : les sous-domaines réservés sont
# `<slug>.PATISGEST_DOMAINE`. Absent : `patisgest.dz`.
# Utilisé par src/proxy.ts, les paramètres établissement et actions-vitrine.
PATISGEST_DOMAINE=

# === Licence & abonnement ===
# Mode « tout gratuit » (défaut = 1). Tant qu'il est actif : aucun essai qui
# s'écoule, aucun écran de verrouillage, aucun paiement dans l'application ; les
# comptes créés sont actifs sans échéance. Mettre 0 pour rouvrir l'essai 60–90 j
# et la validation des paiements depuis /master.
#
# IMPORTANT : ce drapeau commande AUSSI le verrou serveur de `lib/auth.ts`
# (`getSessionContext`). À 1, aucune Server Action n'est verrouillée. À 0, un
# essai échu fait échouer fermées toutes les actions qui lisent ce contexte,
# en plus de l'écran de verrouillage. Le nombre d'actions est mesuré par
# `tests/inventaire-surface.mjs`, pas figé dans un commentaire.
# Aucun autre réglage n'est nécessaire pour basculer.
PATISGEST_MODE_GRATUIT=1

# === Espace Master (/master), licences hors-ligne & alertes >1h ===
# Clé service-role Supabase (requise pour /master et /api/cron/connectivite, côté serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=
# Identifiants de l'administrateur Master (/master)
PATISGEST_MASTER_EMAIL=
PATISGEST_MASTER_KEY=
# Numéro E.164 du Master recevant les alertes SMS/WhatsApp lors d'une coupure > 1h
PATISGEST_MASTER_PHONE=
# Secret Bearer pour l'appel cron (/api/cron/connectivite)
CRON_SECRET=
# Clé JWK privée ECDSA P-256 optionnelle pour signer les jetons de licence.
# Si absente, la graine de signature est dérivée dans cet ordre :
#   PATISGEST_LICENSE_PRIVATE_KEY -> PATISGEST_MASTER_KEY
#   -> VITRINE_SECRET_ANTI_ABUS -> PATISGEST_DEMO_SECRET
# En production, TOUJOURS définir au moins PATISGEST_MASTER_KEY : sinon le
# repli final est une graine de développement publique (src/lib/trial-crypto.ts).
PATISGEST_LICENSE_PRIVATE_JWK=
PATISGEST_LICENSE_PRIVATE_KEY=

# Seuil (minutes, plancher 60) au-delà duquel un compte sans activité reçoit
# une alerte SMS/WhatsApp. Lu par /api/cron/connectivite. Absent : 60.
PATISGEST_OFFLINE_ALERT_MINUTES=

# === Notifications SMS & WhatsApp (adaptateur multi-fournisseur) ===
# Option 1 : Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Option 2 : Webhooks HTTP génériques (JSON { channel, to, message, meta })
PATISGEST_SMS_WEBHOOK_URL=
PATISGEST_WHATSAPP_WEBHOOK_URL=
PATISGEST_WEBHOOK_SECRET=

# === Variables fournies par la plateforme — NE PAS DÉFINIR À LA MAIN ===
# NODE_ENV est injecté par Next.js (development / production / test).
# VERCEL_ENV vaut development | preview | production sur Vercel et n'existe
#   pas hors Vercel : c'est la source de vérité du garde-fou d'aperçu
#   (src/lib/preview-guard.ts).
# PATISGEST_PREVIEW_BLOCKED est calculé dans next.config.ts à partir de
#   VERCEL_ENV et embarqué dans le build. Le définir manuellement fausserait
#   le garde-fou des aperçus non isolés.

# === Outillage hors application (jamais côté serveur Next.js) ===
# Phrase secrète (>= 32 octets) du coffre de fichiers chiffré :
#   node scripts/coffre-sauvegarde.mjs chiffrer entrée sortie
# Lue uniquement par le script local, à passer en variable d'environnement
# du shell — ne pas l'écrire dans .env.local si le fichier est partagé.
# HISTORIQUE : le nom porte « PATSYGEST » (S avant I) et est conservé tel quel,
# avec l'étiquette de fichier PATSYGEST-GCM01, pour ne pas casser les
# trousseaux et scripts déjà en circulation.
PATSYGEST_BACKUP_PASSPHRASE=

# === Fonctionnalités expérimentales (désactivées par défaut) ===
# Ne s'activent qu'en NODE_ENV=development ET hors Vercel (VERCEL_ENV vide).
# Invitations par e-mail de l'équipe (src/lib/equipe-experimental.ts).
PATSYGEST_EQUIPE_EXPERIMENTAL=false
PATSYGEST_TEST_INVITATION_EMAIL=false

# === OCR des bons fournisseurs (VAGUE 6) ===
# Aucune nouvelle variable ni nouveau secret n'est requis. Les modèles FR/ENG
# sont figés dans public/tessdata et le runtime Tesseract.js reste local au
# serveur Node. /api/health/stack réutilise uniquement CRON_SECRET,
# NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY et
# SUPABASE_SERVICE_ROLE_KEY déjà déclarés ci-dessus ; elle ne crée aucune valeur.
