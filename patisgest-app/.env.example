# === PâtisGest — copier vers .env.local et remplir ===
# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle-ta-cle-anon-publique-ici
# Réservé aux scripts (JAMAIS exposé au navigateur)
SUPABASE_SERVICE_ROLE_KEY=colle-ta-cle-service-role-ici
# Supabase > Project Settings > Database > Connection string > Pooler (port 6543)
DATABASE_URL=postgresql://postgres:TON-MOT-DE-PASSE@aws-0-eu-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true
