# === PâtisGest — copier vers .env.local et remplir ===
# Supabase > Project Settings > API
# (valeurs PUBLIques, embarquées dans le bundle navigateur — aucune clé service-role
#  ni chaîne de connexion n'est nécessaire pour l'application)
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=colle-ta-cle-anon-publique-ici

# === Démo locale (développement uniquement, jamais en production) ===
# Les boutons « Essayer » créent un cookie signé côté serveur, sans session Supabase.
# Les données vivent uniquement dans le localStorage du navigateur.
PATISGEST_DEMO_MODE=true
PATISGEST_DEMO_SECRET=remplacer-par-une-valeur-aleatoire-de-32-caracteres-minimum

# === Outils Drizzle uniquement (npm run db:studio / db:push) — optionnel ===
# Non requis par l'application ni par Vercel.
# DATABASE_URL=postgresql://postgres:...@aws-0-eu-xxx.pooler.supabase.com:6543/postgres?pgbouncer=true

# Anti-abus vitrine par source (revue B-008). Secret d'au moins 32 caractères,
# jamais commité. Absent ou trop court : seul le plafond global de la base s'applique.
VITRINE_SECRET_ANTI_ABUS=
