# PâtisGest — variables d'environnement de référence (aucun secret ici)
# Copier vers `patisgest-app/.env.local` (ignoré par Git) ou renseigner
# les variables dans l'environnement de déploiement.
# Surface serveur (actions « use server » et gardes d'accès) : mesuré par `inventaire-surface.mjs`.

# 1. Application — lectures publiques (embarquées dans le bundle)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 2. Application — serveur uniquement
SUPABASE_SERVICE_ROLE_KEY=
PATISGEST_MASTER_EMAIL=
PATISGEST_MASTER_KEY=
CRON_SECRET=
VITRINE_SECRET_ANTI_ABUS=
PATISGEST_DOMAINE=
PATISGEST_OFFLINE_ALERT_MINUTES=
PATISGEST_MASTER_PHONE=
PATISGEST_LICENSE_PRIVATE_JWK=
PATISGEST_LICENSE_PRIVATE_KEY=

# 3. Drapeaux fonctionnels
PATISGEST_MODE_GRATUIT=
PATISGEST_DEMO_MODE=
PATISGEST_DEMO_SECRET=
PATSYGEST_EQUIPE_EXPERIMENTAL=
PATSYGEST_TEST_INVITATION_EMAIL=

# 4. Notifications SMS & WhatsApp (optionnels)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
PATISGEST_SMS_WEBHOOK_URL=
PATISGEST_WHATSAPP_WEBHOOK_URL=
PATISGEST_WEBHOOK_SECRET=

# 5. Outillage / sauvegarde chiffrée (optionnel)
PATSYGEST_BACKUP_PASSPHRASE=
