{
  "name": "patisgest-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.15.0"
  },
  "description": "PâtisGest — gestion pour pâtisseries artisanales (Sprint 1 : socle)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "node scripts/db-push-disabled.mjs",
    "test": "node --experimental-strip-types --experimental-test-module-mocks --import ./tests/mocks/register-hooks.mjs --test tests/*.test.mjs",
    "test:smoke": "node --test tests/smoke-http.mjs",
    "test:preview": "node --test tests/preview-http.mjs",
    "test:e2e": "node --test tests/e2e/*.spec.mjs",
    "test:roadmap": "node --experimental-strip-types --experimental-test-module-mocks --import ./tests/mocks/register-hooks.mjs --test tests/roadmap-vague4.test.mjs tests/roadmap-vague4-db.test.mjs",
    "test:roadmap:live": "node --test tests/roadmap-live-http.mjs",
    "test:roadmap:e2e": "node --test tests/e2e/roadmap-vague4.spec.mjs",
    "test:bench:pglite": "node --experimental-strip-types --test tests/pglite-benchmark.test.mjs",
    "build:chain": "node scripts/construire-chaine-sql.mjs",
    "test:cert:ocr": "node --experimental-strip-types --test tests/ocr-production.test.mjs tests/i18n-ocr-vague6.test.mjs tests/certification-contrats.test.mjs",
    "test:cert:postgresql": "node --experimental-strip-types --test tests/concurrence-transfert-reel.test.mjs",
    "test:cert:concurrency": "node scripts/certification-concurrence-postgres.mjs",
    "test:cert:hosted": "node scripts/certification-production.mjs",
    "test:cert:production": "npm run test:cert:ocr && npm run test:cert:postgresql && npm run test:cert:concurrency && npm run test:cert:hosted",
    "test:obs:sondes": "node scripts/observabilite-sondes.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/nodemailer": "^7.0.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "parse5": "^8.1.1",
    "pg": "^8.23.1",
    "playwright": "^1.65.1",
    "postcss": "8.5.23",
    "smtp-server": "^3.21.6",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
